NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── المساعد الذكي (اختياري بالكامل) ──────────────────────────────────────────
# بدونها يشتغل المساعد بالمحرّك الحتمي المحلي كالمعتاد.
# لا تبدأ بـNEXT_PUBLIC_ عمداً: المفاتيح لا تصل المتصفح أبداً.

# مفتاح Google AI Studio المجاني — من https://aistudio.google.com/apikey
GEMINI_API_KEY=
# اختياري: تثبيت نموذج بعينه. بدونه يجرّب النظام بالترتيب:
#   gemini-3.7-flash ← gemini-3.6-flash ← gemini-3.5-flash-lite
# الحصة اليومية المجانية **لكل نموذج على حدة**، فنفاد الأول لا يعطّل المساعد.
# وضبطه هنا يلغي هذا السقوط — فالاختيار الصريح يُحترم.
GEMINI_MODEL=
# اختياري: مفتاح Anthropic لتشغيل Claude كمزوّد بديل
ANTHROPIC_API_KEY=
# اختياري: المزوّد المفضّل — gemini أو claude (الافتراضي gemini)
ASSISTANT_AI_PROVIDER=

# ── نطق شاشة المطبخ (اختياري بالكامل) ───────────────────────────────────────
# الأفضل والأرخص: ثبّت صوتاً عربياً على التابلت نفسه — مجاني بلا حصة ولا نت.
# وهذي بدائل حين لا يتوفّر ذلك.

# ① Google Cloud Text-to-Speech — المزوّد المفضَّل.
#    حصته المجانية مليون حرف شهرياً؛ احتياج المطبخ كله ~٢٦٠٠ حرف مرة واحدة.
#    لا يقبل مفاتيح API — يحتاج شهادة حساب خدمة (JSON) كاملةً في سطر واحد،
#    أو مرمّزةً بـbase64. الخطوات:
#      1) console.cloud.google.com ← فعّل واجهة Cloud Text-to-Speech
#      2) IAM ← حسابات الخدمة ← أنشئ حساباً ← مفاتيح ← أضف مفتاح JSON
#      3) الصق محتوى الملف هنا
GOOGLE_TTS_CREDENTIALS=

# ② Gemini — يعمل بمفتاح AI Studio نفسه بلا إعداد إضافي، لكن حصته المجانية
#    **عشرة مقاطع في اليوم** وأمر تشغيل واحد يحتاج أربعين. للطوارئ فقط.
GEMINI_TTS_MODEL=

# اختياري: المزوّد المفضَّل — google أو gemini (الافتراضي google ثم gemini)
KITCHEN_TTS_PROVIDER=
